<Project>

  <PropertyGroup Label="SDK Versions">
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Label="Reproducible build">
    <Deterministic>true</Deterministic>
    <!-- Normalizes paths inside .pdb/.dll on CI for reproducible output -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Package information">
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/groupdocs-assembly/GroupDocs.Assembly.Mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/groupdocs-assembly/GroupDocs.Assembly.Mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>GroupDocs Contributors</Authors>
    <Company>Aspose</Company>
    <Copyright>Copyright © Aspose Pty Ltd $([System.DateTime]::Now.Year)</Copyright>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>true</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <PropertyGroup Label="Package Versions">
    <GroupDocsAssemblyMcp>26.11.0</GroupDocsAssemblyMcp>
  </PropertyGroup>

  <PropertyGroup Label="External Dependency Versions">
    <GroupDocsMcpCore>26.9.0</GroupDocsMcpCore>
    <GroupDocsAssembly>26.7.0</GroupDocsAssembly>
    <MicrosoftExtensionsHosting>10.0.5</MicrosoftExtensionsHosting>
    <ModelContextProtocol>1.1.0</ModelContextProtocol>
    <MicrosoftSourceLinkGithub>8.0.0</MicrosoftSourceLinkGithub>
    <!-- Security pin: GroupDocs.Assembly 26.7.0 (GroupDocs.Assembly.Net100) pulls System.Security.Cryptography.Pkcs 9.0.0,
         flagged by NuGet audit (GHSA-846f-f764-76mx high, GHSA-2fmv-rv2c-59x7 moderate); 10.0.13 is the first
         patched 10.x release. Drop once the engine depends on a patched version. -->
    <SystemSecurityCryptographyPkcs>10.0.13</SystemSecurityCryptographyPkcs>
    <!-- No SkiaSharp pin: GroupDocs.Assembly.Net100 26.7.0 declares SkiaSharp 3.119.0 + SkiaSharp.NativeAssets.Linux.NoDependencies
         itself, so the Linux natives resolve transitively. Re-check the engine nuspec after every bump. -->
  </PropertyGroup>

  <PropertyGroup Label="NuGet Common Settings">
    <PackageReleaseNotes>https://github.com/groupdocs-assembly/GroupDocs.Assembly.Mcp/releases/tag/$(GroupDocsAssemblyMcp)</PackageReleaseNotes>
  </PropertyGroup>

</Project>
